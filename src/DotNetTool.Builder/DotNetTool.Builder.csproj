<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.0</TargetFramework>
    <AssemblyName>DotNetTool.Builder</AssemblyName>
    <RootNamespace>DotNetTool.Builder</RootNamespace>
    <Authors>Rene Peuser</Authors>
    <Company>Rene Peuser Softwaresolutions</Company>
    <Description>This dotnet tool allows you creating your own dotnet tool based on Microsofts System.CommandLine.Experimental package.</Description>
    <Copyright>Copyright 2019 (c) Rene Peuser. All rights reserved.</Copyright>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <PackageProjectUrl>https://renepeuser.visualstudio.com/DotNetToolBuilder</PackageProjectUrl>
    <RepositoryUrl>https://renepeuser.visualstudio.com/DotNetToolBuilder</RepositoryUrl>
    <PackageReleaseNotes>Bug-Fixes / Changes
- Add validation for option alias. Alias must begin with a "-"
- Add description check, must have no minimum 10 characters.
- Fix input for optional (o) and required (r) question.
- A root command can contains now "-" name splitter. To use 'my-tool'
  or 'dotnet-mytool' or anything else.
- Fix worng &lt;ToolCommandName&gt; ins csproj file, after generating the tool.
- !! Hint '--from-file' can not be used any more, with older generated tool
  json files !!.

Prerequisites
- .NET Core 3.0 SDK or higher</PackageReleaseNotes>
    <PackageTags>C#;DotNet;.Net;.NetTool;.NetToolBuilder;DotNetToolBuilder;CLI;Build CLI;Build.NetTool;System.CommandLine.Experimental;</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-newtool</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="dotnet.tool.builder.template" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dotnet.tool.builder.template">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\license.txt" Pack="true" PackagePath="license.txt" />
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argument.Check" Version="1.0.1" />
    <PackageReference Include="FileSystem.Abstraction" Version="0.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="3.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="System.CommandLine.Experimental" Version="0.3.0-alpha.19577.1" />
  </ItemGroup>

</Project>
