<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>DotNetTool.Builder</AssemblyName>
    <RootNamespace>DotNetTool.Builder</RootNamespace>
    <Authors>Rene Peuser</Authors>
    <Company>Rene Peuser Softwaresolutions</Company>
    <Description>This dotnet tool allows you creating your own dotnet tool based on Microsofts System.CommandLine.Experimental package.</Description>
    <Copyright>Copyright 2019 (c) Rene Peuser. All rights reserved.</Copyright>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <PackageProjectUrl>https://renepeuser.visualstudio.com/DotNetToolBuilder</PackageProjectUrl>
    <RepositoryUrl>https://renepeuser.visualstudio.com/DotNetToolBuilder</RepositoryUrl>
    <PackageReleaseNotes>Bug-Fixes / Changes
- The tool name must not match project name, causes in namespace conflicts. If Project name starts with lower case then we have no problems.
- Change namespaces not to deepest scope in generated solution.


Prerequisites
- .NET Core 3.1 SDK or higher</PackageReleaseNotes>
    <PackageTags>C#;DotNet;.Net;.NetTool;.NetToolBuilder;DotNetToolBuilder;CLI;Build CLI;Build.NetTool;System.CommandLine;CommandLine;GlobalTool;LocalTool;Tool;</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-newtool</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="dotnet.tool.builder.template" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dotnet.tool.builder.template">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\license.txt" Pack="true" PackagePath="license.txt" />
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argument.Check" Version="1.0.4" />
    <PackageReference Include="Extensions.Pack" Version="0.1.1-beta-3" />
    <PackageReference Include="FileSystem.Abstraction" Version="0.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="3.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="System.CommandLine" Version="0.3.0-alpha.20054.1" />
  </ItemGroup>

</Project>
